[Unit]
Description=bastion-open security scan
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/bastion-open
ExecStart=/usr/bin/docker compose run --rm scanner
# or native mode (no container):
# ExecStart=/usr/bin/python3 /opt/bastion-open/scan.py
